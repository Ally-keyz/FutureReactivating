# ── Application ──────────────────────────────
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://yourdomain.com

# ── MongoDB Atlas ────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ocp_platform?retryWrites=true&w=majority

# ── JWT Secrets (openssl rand -hex 64) ───────
JWT_SECRET=replace_with_64_char_random_hex
JWT_REFRESH_SECRET=replace_with_different_64_char_random_hex
ADMIN_JWT_SECRET=replace_with_admin_64_char_random_hex
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_JWT_EXPIRES_IN=8h

# ── Platform Defaults ────────────────────────
DEPOSIT_PHONE=+250788000000
DEPOSIT_PHONE_NAME=OCP Investment Ltd
MIN_RECHARGE=5000
MIN_WITHDRAWAL=10000
MAX_WITHDRAWAL_PER_DAY=5000000
